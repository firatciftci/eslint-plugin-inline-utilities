{
  "name": "eslint-plugin-inline-utilities",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "ESLint rules that keep utility classes on the element they style, for Tailwind CSS, UnoCSS and Master CSS",
  "author": "Firat Ciftci <2052855+firatciftci@users.noreply.github.com>",
  "homepage": "https://github.com/firatciftci/eslint-plugin-inline-utilities",
  "bugs": {
    "url": "https://github.com/firatciftci/eslint-plugin-inline-utilities/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firatciftci/eslint-plugin-inline-utilities.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "tailwind",
    "tailwindcss",
    "unocss",
    "master-css",
    "utility-first",
    "atomic-css",
    "utility-classes",
    "svelte",
    "vue",
    "react",
    "astro",
    "angular",
    "solid",
    "qwik",
    "lit",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "knip && eslint --concurrency auto .",
    "lint:fix": "knip --fix && eslint --concurrency auto --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "release": "bumpp"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "@angular-eslint/template-parser": "^21.0.0",
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^24.13.4",
    "@typescript-eslint/parser": "^8.70.0",
    "astro-eslint-parser": "^1.2.2",
    "bumpp": "^12.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-erasable-syntax-only": "^0.7.1",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.0",
    "knip": "^6.35.1",
    "oxfmt": "^0.67.0",
    "svelte": "^5.57.0",
    "svelte-eslint-parser": "^1.8.1",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.2.0"
  },
  "packageManager": "pnpm@12.3.4"
}
